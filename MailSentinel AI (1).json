    {
      "parameters": {
        "promptType": "define",
        "text": "=Generate a customer-facing email response based on the original customer email, the AI-generated draft, and the human review decision.\n\n**Original customer email:**\nSender: {{ $('data cleaning').item.json.sender }}\nSubject:{{ $('data cleaning').item.json.subject }}\nMessage: {{ $('data cleaning').item.json.body }}\n\n**Original AI response draft:**\n{{ $('MailSentinel AI Agent').item.json.output.response_draft }}\n\n**Reason for human review:**\n{{ $('MailSentinel AI Agent').item.json.output.reason }}\n\n**Human review decision:**\n{{ $('MailSentinel AI Agent').item.json.output.needs_human_review }}\n\n**Instructions:**\n- If the decision is `approved`, inform the customer that their request has been reviewed and approved. Explain the next steps and state that the expected resolution time is 3–7 days.\n- If the decision is `rejected`, inform the customer that their request requires further investigation and has been escalated for additional review. Do not promise resolution within 3–7 days.\n- Keep the response professional, clear, concise, and empathetic.\n- Address the customer's actual issue using the original email and AI draft as context.\n- Do not expose internal AI reasoning, internal review notes, or approval system details.\n- Do not claim a refund, account change, or other action has been completed unless explicitly confirmed.\n- Do not invent policies, facts, or commitments.\n- Include a suitable greeting and sign-off from the Customer Support Team.\n- Return only the final customer-facing email body. Do not include a subject line or explanations.\n- Do not include customer name .",
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1696,
        -112
      ],
      "id": "88dca0f6-5474-42d4-8189-5ee8aecd53ef",
      "name": "Response Drafter"
    },
    {
      "parameters": {
        "fromEmail": "rohannarlawar@yahoo.com",
        "toEmail": "={{ $('data cleaning').item.json.sender }}",
        "subject": "Update on your Request - MailSentinel AI",
        "html": "=\n<!DOCTYPE html>\n<html>\n<body style=\"font-family: Arial, sans-serif; color: #333; line-height: 1.6;\">\n  <p>Hello,</p>\n\n  <p>Thank you for contacting our support team. We have reviewed your request.</p>\n\n  <p><strong>Subject:</strong> {{ $('data cleaning').item.json.subject }}</p>\n\n  <p>{{ $('MailSentinel AI Agent').item.json.output.response_draft }}</p>\n\n  <p><strong>Expected resolution:</strong> Within 3–7 days.</p>\n\n  <p>Thank you for your patience. We will contact you if additional information is required.</p>\n\n  <p>Best regards,<br>\n  Customer Support Team</p>\n</body>\n</html>\n",
        "options": {}
      },
